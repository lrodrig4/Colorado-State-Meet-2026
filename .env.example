# Public app defaults. Do not put credentials in this file.
NEXT_PUBLIC_DEFAULT_CLASSIFICATION=4A
NEXT_PUBLIC_LOCK_CLASSIFICATION=false

# Optional Supabase-backed school mascot PNGs and brand metadata.
# Public anon key is used only for approved read-only assets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_MASCOT_BUCKET=school-mascots

# Server-only key for the local upload script. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only performance table override. The app also accepts
# NEXT_PUBLIC_SUPABASE_ANON_KEY for read-only performance fetches. Do not use
# the service-role key for normal app reads.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PERFORMANCES_TABLE=performances
SUPABASE_REVALIDATE_SECONDS=300

# Server-only route guards. Required in production for cron/admin endpoints.
CRON_SECRET=
ADMIN_API_SECRET=

# Optional local-only importer cookies. Leave blank unless running a local scrape.
# Never commit real cookie values.
MILESPLIT_COOKIE=
MAXPREPS_COOKIE=
