    "seed:maxpreps-3a": "MAXPREPS_CLASSIFICATION=3A tsx scripts/import-maxpreps-5a-rankings.ts",
    "audit:3a": "AUDIT_CLASSIFICATION=3A tsx scripts/audit-class-verification.ts",
    "test": "tsx --test src/**/*.test.ts"
